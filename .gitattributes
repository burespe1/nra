# Binary files in Git LFS. The model is "lockable": it is read-only after checkout
# until you lock it (git lfs lock model/NRA.qea) – this replaces unlocked.docx.
*.qea  filter=lfs diff=lfs merge=lfs -text lockable
*.docx filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
xmi/*.xml filter=lfs diff=lfs merge=lfs -text
# Generated text export: stable line endings for clean diffs
export/** text eol=lf
tools/** text eol=lf
